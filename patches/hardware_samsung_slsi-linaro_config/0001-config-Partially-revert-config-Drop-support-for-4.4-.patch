From 8bfcd8200f2d91d76355174bd23f8bfa4a9df01c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Umut=20=C3=87a=C4=9Fan=20Demirer?=
 <umutcagand@protonmail.com>
Date: Thu, 19 Nov 2026 17:56:59 +0300
Subject: [PATCH 1/2] config: Partially revert "config: Drop support for 4.4
 kernels"

Bring back exynos7885 and exynos7904, the Galaxy M20 runs a 5.10
kernel on lineage-24.0.

This partially reverts commit 1ffe0b5e029790407b57444b10a4de685c714f20.

Assisted-by: LLM
Change-Id: Iddfb23e1c2f2d9981966167431550d60d9b501e6
---
 BoardConfig7885.mk | 63 ++++++++++++++++++++++++++++++++++++++++++++++
 BoardConfig7904.mk | 18 +++++++++++++
 gralloc1.mk        | 10 ++++++++
 gralloc3.mk        | 13 ++++++++++
 4 files changed, 104 insertions(+)
 create mode 100644 BoardConfig7885.mk
 create mode 100644 BoardConfig7904.mk

diff --git a/BoardConfig7885.mk b/BoardConfig7885.mk
new file mode 100644
index 0000000..a3a9745
--- /dev/null
+++ b/BoardConfig7885.mk
@@ -0,0 +1,63 @@
+#
+# Copyright (C) 2022 The LineageOS Project
