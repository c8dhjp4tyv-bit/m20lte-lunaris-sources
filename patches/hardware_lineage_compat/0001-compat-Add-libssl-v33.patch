From 704d160d38c5b59261f02995aa3f01e462b17e72 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Umut=20=C3=87a=C4=9Fan=20Demirer?=
 <umutcagand@protonmail.com>
Date: Thu, 19 Nov 2026 08:54:00 +0300
Subject: [PATCH 1/2] compat: Add libssl-v33

Pairs with libcrypto-v33 for blobs that break with the current
BoringSSL ABI, e.g. Samsung gpsd crashing in X509_verify_cert during
SUPL TLS. Taken from the v33 VNDK snapshot, renamed and relinked
against libcrypto-v33.

Assisted-by: LLM
Change-Id: I6ebe19dbf7553de15be6b3d59edb7658d2e4d7b9
---
 Android.bp                   |  18 ++++++++++++++++++
 vndk/v33/arm/libssl-v33.so   | Bin 0 -> 319369 bytes
 vndk/v33/arm64/libssl-v33.so | Bin 0 -> 479097 bytes
 3 files changed, 18 insertions(+)
 create mode 100755 vndk/v33/arm/libssl-v33.so
 create mode 100755 vndk/v33/arm64/libssl-v33.so

diff --git a/Android.bp b/Android.bp
index e57d86e..0c86695 100644
--- a/Android.bp
+++ b/Android.bp
@@ -247,6 +247,24 @@ cc_prebuilt_library_shared {
     compile_multilib: "both",
 }
 
+cc_prebuilt_library_shared {
+    name: "libssl-v33",
+    vendor: true,
+    strip: {
+        none: true,
+    },
+    shared_libs: ["libcrypto-v33"],
+    target: {
+        android_arm: {
+            srcs: ["vndk/v33/arm/libssl-v33.so"],
+        },
+        android_arm64: {
+            srcs: ["vndk/v33/arm64/libssl-v33.so"],
+        },
+    },
+    compile_multilib: "both",
+}
+
 cc_library {
     name: "libcrypto_shim",
     srcs: [
diff --git a/vndk/v33/arm/libssl-v33.so b/vndk/v33/arm/libssl-v33.so
new file mode 100755
