From 7e9c8c50d8a3424f32034b5d1eeba651a994ee3f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Umut=20=C3=87a=C4=9Fan=20Demirer?=
 <umutcagand@protonmail.com>
Date: Thu, 19 Nov 2026 10:08:35 +0300
Subject: [PATCH 4/8] universal7904: sepolicy: Use the Lineage libion policy

Label /dev/ion as ion_device through device/lineage/sepolicy/libion
instead of reusing the DMA-BUF system heap type.

Assisted-by: LLM
Change-Id: I4ff039d15bf87eb8d41042f12a0571403118acc8
---
 BoardConfigCommon.mk          | 1 +
 sepolicy/vendor/file_contexts | 1 -
 2 files changed, 1 insertion(+), 1 deletion(-)

diff --git a/BoardConfigCommon.mk b/BoardConfigCommon.mk
index 269a635..91b0a6b 100644
--- a/BoardConfigCommon.mk
+++ b/BoardConfigCommon.mk
@@ -151,6 +151,7 @@ ENABLE_VENDOR_RIL_SERVICE := true
 # Sepolicy
 ifneq ($(LINEAGE_BUILD),)
 include device/lineage/sepolicy/exynos/sepolicy.mk
+include device/lineage/sepolicy/libion/sepolicy.mk
 endif
 include device/samsung_slsi/sepolicy/sepolicy.mk
 BOARD_VENDOR_SEPOLICY_DIRS += $(COMMON_PATH)/sepolicy/vendor
diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
index 217a3d5..91f5a5f 100644
--- a/sepolicy/vendor/file_contexts
+++ b/sepolicy/vendor/file_contexts
@@ -1,5 +1,4 @@
 # Devices
-/dev/ion                                                      u:object_r:dmabuf_system_heap_device:s0
 /dev/mali[0-9]*                                               u:object_r:gpu_device:s0
 /dev/umts_ipc0                                                u:object_r:radio_device:s0
 /dev/fimg2d                                                   u:object_r:video_device:s0
