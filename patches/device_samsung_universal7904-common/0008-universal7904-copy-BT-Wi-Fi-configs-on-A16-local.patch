From 539424167b7c5949c9c9ba3c1d1d5c0a3b40c97f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Umut=20=C3=87a=C4=9Fan=20Demirer?= <umutcagand@protonmail.com>
Date: Thu, 19 Nov 2026 22:44:46 +0000
Subject: [PATCH 8/8] universal7904: copy BT/Wi-Fi configs on A16 (local)

---
 configs/wifi/wpa_supplicant.conf | 5 +++++
 universal7904-common.mk          | 9 +++++----
 2 files changed, 10 insertions(+), 4 deletions(-)
 create mode 100644 configs/wifi/wpa_supplicant.conf

diff --git a/configs/wifi/wpa_supplicant.conf b/configs/wifi/wpa_supplicant.conf
new file mode 100644
index 0000000..4d05858
--- /dev/null
+++ b/configs/wifi/wpa_supplicant.conf
@@ -0,0 +1,5 @@
+update_config=1
+eapol_version=1
+ap_scan=1
+fast_reauth=1
+p2p_add_cli_chan=1
diff --git a/universal7904-common.mk b/universal7904-common.mk
index 22e12f3..870e8b7 100644
--- a/universal7904-common.mk
+++ b/universal7904-common.mk
@@ -30,7 +30,6 @@ PRODUCT_COPY_FILES += \
 
 # Bluetooth
 PRODUCT_PACKAGES += \
-    bt_did.slsi.conf \
     android.hardware.bluetooth@1.1-service \
     android.hardware.bluetooth.audio-impl \
     audio.bluetooth.default \
@@ -280,9 +279,11 @@ PRODUCT_SOONG_NAMESPACES += \
     hardware/samsung_slsi/libbt \
     hardware/samsung_slsi/scsc_wifibt/wpa_supplicant_lib
 
-# Wi-Fi supplicant config generated by wpa_supplicant_lib
-PRODUCT_PACKAGES += \
-    wpa_supplicant.conf
+# A16: copy the configs (no bt_did.slsi.conf / generated wpa_supplicant.conf modules)
+PRODUCT_COPY_FILES += \
+    hardware/samsung_slsi/libbt/conf/bt_did.conf:$(TARGET_COPY_OUT_VENDOR)/etc/bluetooth/bt_did.conf \
+    hardware/samsung_slsi/libbt/conf/bt_vendor.conf:$(TARGET_COPY_OUT_VENDOR)/etc/bluetooth/bt_vendor.conf \
+    $(LOCAL_PATH)/configs/wifi/wpa_supplicant.conf:$(TARGET_COPY_OUT_VENDOR)/etc/wifi/wpa_supplicant.conf
 
 # Speed profile services and wifi-service to reduce RAM and storage
 PRODUCT_SYSTEM_SERVER_COMPILER_FILTER := speed-profile
-- 
2.43.0

